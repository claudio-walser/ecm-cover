; travel_max_lift = 1.5,1.5,1.5,1.5,1.5
; travel_ramping_lift = 1,1,1,1,1
; travel_short_distance_acceleration = 250
; travel_slope = 1,1,1,1,1
; travel_speed = 400
; travel_speed_z = 12
; use_firmware_retraction = 0
; use_relative_e_distances = 1
